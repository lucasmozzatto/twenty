# Copie para .env (o bootstrap.sh faz isso e gera os segredos sozinho).

# Versão do Twenty — fixada de propósito. Atualize DELIBERADAMENTE:
# mude o número, rode `docker compose pull && docker compose up -d`
# (as migrações de banco rodam sozinhas na subida do server).
TAG=v2.15.0

# Domínio do CRM (o Caddy emite o certificado HTTPS sozinho para ele)
CRM_DOMAIN=crm.petbeetools.com.br
SERVER_URL=https://crm.petbeetools.com.br

# Segredos — o bootstrap.sh preenche com valores aleatórios fortes
PG_DATABASE_PASSWORD=TROQUE_ME
ENCRYPTION_KEY=TROQUE_ME
APP_SECRET=TROQUE_ME

# Login Google (SSO) + sincronização Gmail/Agenda — opcional.
# Crie as credenciais OAuth no Google Cloud (app "Interno" restringe ao
# Workspace @petbee.com.br) e descomente preenchendo:
# AUTH_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# AUTH_GOOGLE_CLIENT_SECRET=xxxxx
# AUTH_GOOGLE_CALLBACK_URL=https://crm.petbeetools.com.br/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://crm.petbeetools.com.br/auth/google-apis/get-access-token
# MESSAGING_PROVIDER_GMAIL_ENABLED=true
# CALENDAR_PROVIDER_GOOGLE_ENABLED=true
